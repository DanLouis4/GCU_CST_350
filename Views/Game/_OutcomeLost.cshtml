@* Shows the lost details *@
@{
    // --- 0. RETRIEVE LOSS DETAILS ---------------------------------------------------
    string elapsed = ViewBag.ElapsedTime ?? "00:00";
    int score = ViewBag.FinalScore ?? 0;
}

<!-- -------------------------------------------------------------------------------
     LOSS DISPLAY PANEL
     Shown when the player clicks a bomb and the game ends immediately.
-------------------------------------------------------------------------------- -->
<div class="outcome-panel outcome-lost">

    <!-- 1. LOSS MESSAGE -------------------------------------------------------- -->
    <h2 class="text-danger">Game Over</h2>
    <p>You triggered a bomb.</p>

    <!-- 2. GAME STATISTICS ----------------------------------------------------- -->
    <p><strong>Time:</strong> @elapsed</p>
    <p><strong>Final Score:</strong> @score</p>

    <!-- 3. ACTION BUTTON ------------------------------------------------------- -->
    <a href="/Game/StartGame" class="btn btn-danger mt-2">Play Again</a>

</div>
