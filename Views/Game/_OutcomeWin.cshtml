@* Shows the win details *@
@{
    // --- 0. RETRIEVE WIN DETAILS ----------------------------------------------------
    string elapsed = ViewBag.ElapsedTime ?? "00:00";
    int score = ViewBag.FinalScore ?? 0;
}

<!-- -------------------------------------------------------------------------------
     WIN DISPLAY PANEL
     Shown when the player reveals all safe tiles without hitting a bomb.
--------------------------------------------------------------------------------- -->
<div class="outcome-panel outcome-win">

    <!-- 1. WIN MESSAGE --------------------------------------------------------- -->
    <h2 class="text-success">You Win!</h2>
    <p>All safe tiles have been revealed.</p>

    <!-- 2. GAME STATISTICS ----------------------------------------------------- -->
    <p><strong>Time:</strong> @elapsed</p>
    <p><strong>Final Score:</strong> @score</p>

    <!-- 3. ACTION BUTTON ------------------------------------------------------- -->
    <a href="/Game/StartGame" class="btn btn-success mt-2">Play Again</a>

</div>
