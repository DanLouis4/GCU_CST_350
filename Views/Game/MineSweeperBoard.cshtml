@model MineSweeper_MVC.Models.Board
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<div class="ajax-proof text-muted text-md-center small mb-2">
    Game ID: <strong>@Model.GameId</strong> |
    Game Started: <strong>@Model.StartTime.ToLocalTime().ToString("HH:mm:ss")</strong>
</div>


<div class="info-section timer-center timer-wrapper">
    <div class="info-row label-large">Timer:</div>
    <div class="info-row timer-value"
         id="game-timer"
         data-start="@Model.StartTime.ToString("o")">
        0:00
    </div>
</div>

<div id="game-state-area">
    <partial name="_GameState" model="Model" />
</div>


