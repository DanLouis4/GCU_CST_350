<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MineSweeper 350C</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MineSweeper_MVC.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bungee+Shade&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom mb-3">
            <div class="container">

                <!-- LEFT: Brand -->
                <a class="navbar-brand bungee-title nav-logo" asp-controller="Home" asp-action="Index">MINESWEEPER</a>

                <!-- MOBILE TOGGLE -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- NAV CONTENT -->
                <div class="collapse navbar-collapse" id="navbarContent">

                    <!-- LEFT NAV LINKS -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Game" asp-action="StartGame">Home</a>
                        </li>
                    </ul>

                    <!-- RIGHT SIDE AUTH LINKS -->
                    @using Microsoft.AspNetCore.Http

                    <ul class="navbar-nav ms-auto">

                        @if (Context.Session.GetString("Username") == null)
                        {
                            <!-- Not logged in -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="User" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="User" asp-action="Register">Sign Up</a>
                            </li>
                        }
                        else
                        {
                            <!-- Logged in -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    Welcome, @Context.Session.GetString("Username")
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end text-end">
                                    <li><a class="dropdown-item" asp-controller="User" asp-action="Profile">Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Game" asp-action="Index">Scores</a></li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li><a class="dropdown-item" asp-controller="User" asp-action="Logout">Logout</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MineSweeper.350 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
